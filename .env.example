PORT=8080
DATABASE_PATH=/data/homeready.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
BUSINESS_PHONE=
PUBLIC_BASE_URL=http://localhost:8080

# Local timezone for night-before send and morning hold cutoff (US owners: America/Chicago, etc.)
TZ=UTC
CHECKLIST_SEND_HOUR=18
HOLD_CUTOFF_HOUR=6

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy link / blurbs without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional Twilio SMS. Leave unset; product works via Copy link alone.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional owner alerts on Ready / Not Ready / auto-hold when SMTP is set.
OWNER_NOTIFY_EMAIL=

# Optional footer link labeled "Powered by HomeReady". Leave empty for no footer.
MARKETING_URL=
